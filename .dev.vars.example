# 复制为 .dev.vars 后填写（.dev.vars 已被 gitignore，勿提交真实密钥）
# 生产环境用 wrangler secret put <KEY> 逐个配置

# 管理后台密钥（保护 /admin/api/*）。本地 D1 初始化：npx wrangler d1 migrations apply providers_db --local
# 网关调用 token 不在此配置——启动后经 /admin 后台管理（存 D1）。
ADMIN_TOKEN=change-me-admin

# chat 供应商（每个 provider 文件声明自己读哪个变量）
# 注：SILICONFLOW_API_KEY 同时供 embeddings 供应商（上游模型 BAAI/bge-m3）
#     与 rerank 供应商（上游模型 BAAI/bge-reranker-v2-m3）使用
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
AGNES_API_KEY=
SILICONFLOW_API_KEY=
GPTSAPI_API_KEY=
DOTS_API_KEY=
ZHIPU_API_KEY=
SENSENOVA_API_KEY=

# read 供应商（JINA_API_KEY 同时供 embeddings 供应商 jina 使用：上游模型 jina-embeddings-v5-omni-small）
# FIRECRAWL_API_KEY 同时供 search 供应商 firecrawl 使用
JINA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# search 供应商（anysearch 官方支持匿名访问，未配置时低限流调用）
ANYSEARCH_API_KEY=

# email 供应商（host/port/ssl/用户名/发件人写死在各 provider 文件，仅密钥走环境变量）
# sendgrid：HTTP API 发送
SENDGRID_API_KEY=
# exmail（腾讯企业邮箱）：SMTP 密码或客户端专用密码（后台开了安全登录时须用后者）
EXMAIL_SMTP_PASSWORD=
